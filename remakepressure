local function check(target)
 if died then return end
 if target then
  --判断and locals--
  local toolname = false
  local toolbackname = ""
  for name,part in pairs(tool) do
   if string.find(target.Name,name) then
    toolname = true
    toolbackname = name
   end
  end
  local mode = "^(Currency)(%d+)"
  if string.find(target.Name,"U") then
   mode = "^(UCurrency)(%d+)"
  end
  local drop = false
  if target.Parent then
   if target.Parent == DI then
    drop = true
   end
  end
  local neo = "Neostyk"
  if drop then
   neo = "NeoStyk"
  end
  local cur = string.match(target.Name,"Currency")
  local _,num = string.match(target.Name,mode)
  local sb,eb = string.find(target.Name,"Battery")
  local sn,en = string.find(target.Name,neo)
  --end--
  if cur then
  
   local ba = addMarker(target,"$"..num,Color3.fromRGB(255,250,0),Color3.fromRGB(255,250,0))
   table.insert(ESPa.cur,ba)
   if not ESPt.currency then ba.Enabled = false end
  elseif toolname then
  
   local endba = nil
   if target.Name == "PasswordPaper" then
    local ba = addMarker(target,"密码纸 密码："..target:WaitForChild("Code").SurfaceGui.TextLabel.text,Color3.fromRGB(128,0,128),Color3.fromRGB(128,0,128))
    endba = ba
   elseif target.Name == "RedeemerRevolver" then
   
    local ba = addMarker(target,"枪",Color3.fromRGB(255,0,0),Color3.fromRGB(255,0,0))
    endba = ba
   else
    local ba = addMarker(target,tool[toolbackname].name,drop and Color3.fromRGB(255,165,0) or tool[toolbackname].rare and Color3.fromRGB(128,0,128) or Color3.fromRGB(0,255,255),drop and Color3.fromRGB(255,165,0) or tool[toolbackname].rare and Color3.fromRGB(128,0,128) or Color3.fromRGB(0,255,255))
    endba = ba
   end
   table.insert(ESPa.item,endba)
   if not ESPt.item then endba.Enabled = false end
  elseif sb or sn then
  
   local endba = nil
   if sb then
    local ba = addMarker(target,"电池",Color3.fromRGB(0,255,250),Color3.fromRGB(0,255,250))
    endba = ba
   else
    local ba = addMarker(target,"胶囊",Color3.fromRGB(0,255,250),Color3.fromRGB(0,255,250))
    endba = ba
   end
   table.insert(ESPa.item,endba)
   if not ESPt.item then endba.Enabled = false end
  elseif target:IsA("ProximityPrompt") then
   if ESPt.isit then
    target.HoldDuration = 0
   end
   table.insert(ESPa.isited,target)
  elseif dmapa[target.Name] then
   
    target:Destroy()
    if debugmode then print ("已删除一个damagepart") end
  elseif target.Name == "NormalDoor" or target.Name == "BigDoor" then
    if debugmode then print ("opened a door") end
    local pd = target.Parent
    local pdp = target.Parent
    if pdp then pdp = pdp.Parent end
    local catch = nil
    local catch2 = nil
    if pd or pdp then
     if pd.Name == "Entrances" or pdp.Name == "Entrances" and not target:IsA("Folder") then
      for _,hl in ipairs(ESPa.doors) do
       hl:Destroy()
      end
      wait(0.3)
      local pf = player:FindFirstChild("PlayerFolder")
      local openedthing = pf:FindFirstChild("DoorsOpened")
      local opened = openedthing.Value
      if target.Name == "NormalDoor" or target.Name == "BigDoor" then
       local ba = addMarker(target,"门 门数: "..tostring(opened + 1),Color3.fromRGB(0,255,250),Color3.fromRGB(0,255,250))
       local ba2 = addhl(target,Color3.fromRGB(0,110,255))
       catch = ba
       catch2 = ba2
       if catch then
        table.insert(ESPa.doors,catch)
        table.insert(ESPa.doors,catch2)
        if not ESPt.door then catch.Enabled = false end
        if not ESPt.door then catch2.Enabled = false end
       end
      elseif target.Name == "DoubleDoor" or target.Name == "DoubleDoorSewer" then
       catch = {}
       catch22 = {}
       for _,tg in ipairs(target:GetChildren()) do
        if tg.Name == "NormalDoor" then
         local ba = addMarker(tg,"门 门数: "..tostring(opened + 1),Color3.fromRGB(0,255,250),Color3.fromRGB(0,255,250))
         local ba2 = addhl(tg,Color3.fromRGB(0,110,255))
         table.insert(catch,ba)
         table.insert(catch2,ba2)
        end
       end
       if #catch >= 0 then
        for _,hl in ipairs(catch) do
         table.insert(ESPa.doors,hl)
         if not ESPt.door then hl.Enabled = false end
        end
       end
       if #catch2 >= 0 then
        for _,hl in ipairs(catch2) do
         table.insert(ESPa.doors,hl)
         if not ESPt.door then hl.Enabled = false end
        end
       end
      end
     end
    end
  end
 end
